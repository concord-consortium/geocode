[
  { "name": "app on models-resources.concord.org", "allowed": true,
    "headers": { "sec-fetch-site": "same-origin", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "https://models-resources.concord.org/geocode-app/branch/master/index.html" } },
  { "name": "app inside activity-player.concord.org", "allowed": true,
    "headers": { "sec-fetch-site": "same-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "https://models-resources.concord.org/" } },
  { "name": "tile opened in a new tab", "allowed": true,
    "headers": { "sec-fetch-site": "none", "sec-fetch-mode": "navigate", "sec-fetch-dest": "document" } },
  { "name": "tile link clicked on another site", "allowed": true,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "navigate", "sec-fetch-dest": "document",
                 "referer": "https://app.slack.com/" } },
  { "name": "local development server", "allowed": true,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "http://localhost:8080/" } },
  { "name": "local development on 127.0.0.1", "allowed": true,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "http://127.0.0.1:8080/index.html" } },
  { "name": "older browser without Sec-Fetch on a concord.org page", "allowed": true,
    "headers": { "referer": "https://learn.concord.org/" } },

  { "name": "another site embedding the tiles", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "https://example.com/map.html" } },
  { "name": "another site as an <img>", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "no-cors", "sec-fetch-dest": "image",
                 "referer": "https://example.com/" } },
  { "name": "another site hiding its referrer", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty" } },
  { "name": "another site framing a tile", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "navigate", "sec-fetch-dest": "iframe",
                 "referer": "https://example.com/" } },
  { "name": "look-alike domain ending in concord.org", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "https://evilconcord.org/" } },
  { "name": "look-alike domain starting with concord.org", "allowed": false,
    "headers": { "sec-fetch-site": "cross-site", "sec-fetch-mode": "cors", "sec-fetch-dest": "empty",
                 "referer": "https://concord.org.example.com/" } },
  { "name": "older browser without Sec-Fetch on another site", "allowed": false,
    "headers": { "referer": "https://example.com/" } },
  { "name": "script with no browser headers", "allowed": false,
    "headers": {} }
]
